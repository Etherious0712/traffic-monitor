# Free key from https://developer.tomtom.com (no credit card needed).
# Without it you still get news + weather warnings, but no traffic.
TOMTOM_KEY=

PORT=3000

# The city someone is looking at refreshes every POLL_MINUTES; every other city every SLOW_POLL_MINUTES.
# News and weather refresh every POLL_MINUTES.
POLL_MINUTES=5
SLOW_POLL_MINUTES=180
# Stop calling TomTom for the rest of the day (UTC) after this many calls. The free tier is 2,500 a day.
TOMTOM_DAILY_LIMIT=2400

# Cities to include (comma-separated). Empty = all 27:
#   klang-valley, penang, johor-bahru, ipoh, taiping, melaka, seremban, alor-setar, sungai-petani, kangar, kuantan, kota-bharu, kuala-terengganu,
#   kota-kinabalu, sandakan, tawau, lahad-datu, keningau,
#   kuching, sri-aman, sarikei, sibu, kapit, bintulu, miri, limbang, lawas
REGIONS=

# History is kept in a local SQLite file (built into Node, nothing to install).
HISTORY_DAYS=90
HISTORY_FILE=data/history.db

# Optional AI cause analysis. Any OpenAI-compatible endpoint works. Free options:
#   Ollama (local):  AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=qwen2.5:7b   (no key)
#   Groq:            AI_BASE_URL=https://api.groq.com/openai/v1
#   Gemini:          AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter:      AI_BASE_URL=https://openrouter.ai/api/v1   (pick a ":free" model)
# Leave AI_BASE_URL empty to use the built-in rules only.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_CALLS_PER_DAY=200
